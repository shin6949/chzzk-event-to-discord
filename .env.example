# Copy this file to .env before running docker compose.
#
# Docker Compose reads .env for ${...} interpolation. Do not commit the real
# .env because it contains OAuth and database secrets.

# PostgreSQL 17.4 container and backend JDBC connection
APP_DB_NAME=chzzk_event_to_discord
APP_DB_DRIVER=org.postgresql.Driver
APP_DB_URL=jdbc:postgresql://postgres:5432/chzzk_event_to_discord
APP_DB_USER=chzzk
APP_DB_PASSWORD=change-me
APP_DB_MAX_POOL_SIZE=10
APP_DB_MIN_IDLE=2
APP_DB_CONNECTION_TIMEOUT_MS=9000
APP_DB_IDLE_TIMEOUT_MS=600000
APP_DB_MAX_LIFETIME_MS=1800000
APP_DB_KEEPALIVE_TIME_MS=0

# Oracle DB 21c example for an external database:
# APP_DB_DRIVER=oracle.jdbc.OracleDriver
# APP_DB_URL=jdbc:oracle:thin:@//oracle-host:1521/service_name
# APP_DB_USER=chzzk
# APP_DB_PASSWORD=change-me
# APP_DB_MAX_POOL_SIZE=10
# APP_DB_MIN_IDLE=2

# CHZZK OAuth
CHZZK_OAUTH_CLIENT_ID=your-chzzk-client-id
CHZZK_OAUTH_CLIENT_SECRET=your-chzzk-client-secret
CHZZK_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/chzzk/callback
CHZZK_OAUTH_AUTH_BASE_URL=https://chzzk.naver.com
CHZZK_OAUTH_TOKEN_BASE_URL=https://openapi.chzzk.naver.com
CHZZK_OAUTH_API_BASE_URL=https://openapi.chzzk.naver.com

# CHZZK polling/API
CHZZK_CHECK_INTERVAL=30
CHZZK_API_URL=https://api.chzzk.naver.com

# YouTube Data API v3 polling
YOUTUBE_CHECK_INTERVAL=60
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_API_KEY=your-youtube-data-api-key

# Twitch EventSub (official Twitch API)
TWITCH_API_BASE_URL=https://api.twitch.tv
TWITCH_AUTH_BASE_URL=https://id.twitch.tv
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
# Public HTTPS origin that Twitch can call. Backend appends /api/v1/twitch/eventsub.
TWITCH_EVENTSUB_CALLBACK_BASE_URL=https://your-public-domain.example.com
# 10-100 chars recommended; keep stable for EventSub HMAC verification.
TWITCH_EVENTSUB_SECRET=replace-with-random-eventsub-secret

# Backend application options
APP_INSERT_PASSWORD=
APP_DEFAULT_TIMEZONE=Asia/Seoul
APP_IS_TEST=false
APP_AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_AUTH_JWT_ISSUER=chzzk-event-to-discord
APP_AUTH_JWT_ACCESS_TOKEN_TTL=PT1H
APP_AUTH_JWT_REFRESH_TOKEN_TTL=P30D
APP_AUTH_OAUTH_STATE_TTL=PT5M
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Lax

# Local/test S3-compatible object storage through MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
APP_STORAGE_S3_ENDPOINT=http://minio:9000
APP_STORAGE_S3_BUCKET=chzzk-event-assets
APP_STORAGE_S3_REGION=ap-northeast-2
APP_STORAGE_S3_ACCESS_KEY=minioadmin
APP_STORAGE_S3_SECRET_KEY=minioadmin
APP_STORAGE_S3_FORCE_PATH_STYLE=true
APP_STORAGE_S3_DISABLE_CHUNKED_ENCODING=true
APP_STORAGE_S3_PREFIX=bot-profiles
APP_STORAGE_S3_CONNECTION_TIMEOUT_MS=5000
APP_STORAGE_S3_SOCKET_TIMEOUT_MS=60000
APP_STORAGE_S3_API_CALL_ATTEMPT_TIMEOUT_MS=120000
APP_STORAGE_S3_API_CALL_TIMEOUT_MS=120000
APP_STORAGE_S3_AVAILABILITY_CHECK_ENABLED=true
APP_STORAGE_S3_REQUIRED_ON_STARTUP=false
APP_STORAGE_S3_AVAILABILITY_CHECK_INTERVAL_MS=60000
APP_STORAGE_S3_AVAILABILITY_CHECK_TIMEOUT_MS=5000
APP_STORAGE_UPLOAD_MAX_BYTES=5242880
APP_STORAGE_UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/webp
APP_STATIC_CONTENT_URL_PREFIX=http://localhost:9000/chzzk-event-assets

# Oracle Object Storage S3-compatible production example:
# APP_STORAGE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# APP_STORAGE_S3_REGION=<region>
# APP_STORAGE_S3_BUCKET=<bucket>
# APP_STORAGE_S3_ACCESS_KEY=<oci-s3-compat-access-key>
# APP_STORAGE_S3_SECRET_KEY=<oci-s3-compat-secret-key>
# APP_STORAGE_S3_FORCE_PATH_STYLE=true
# APP_STORAGE_S3_DISABLE_CHUNKED_ENCODING=true
# APP_STORAGE_S3_CONNECTION_TIMEOUT_MS=5000
# APP_STORAGE_S3_SOCKET_TIMEOUT_MS=60000
# APP_STORAGE_S3_API_CALL_ATTEMPT_TIMEOUT_MS=120000
# APP_STORAGE_S3_API_CALL_TIMEOUT_MS=120000
# APP_STORAGE_S3_AVAILABILITY_CHECK_ENABLED=true
# APP_STORAGE_S3_REQUIRED_ON_STARTUP=false
# APP_STORAGE_S3_AVAILABILITY_CHECK_INTERVAL_MS=60000
# APP_STORAGE_S3_AVAILABILITY_CHECK_TIMEOUT_MS=5000
# APP_STATIC_CONTENT_URL_PREFIX=https://static.example.com

# Frontend build-time API base URL.
# Keep /api/v1 for same-origin access through the frontend Nginx proxy.
VITE_API_BASE_URL=/api/v1
